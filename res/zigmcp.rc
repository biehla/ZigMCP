// DOC-4: the Windows release binary carries a manifest (asInvoker, supported
// OS) and a version resource, so Explorer shows a product and version and
// Windows applies no compatibility heuristics.

1 24 "zigmcp.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "ZigMCP"
      VALUE "FileDescription", "ZigMCP MCP server"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "zigmcp"
      VALUE "OriginalFilename", "zigmcp.exe"
      VALUE "ProductName", "ZigMCP"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
