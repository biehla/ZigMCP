# Zig build output
/zig-out/
/.zig-cache/

# Scratch used for local stdlib/API verification — never committed
/.probe/

# CI failure logs downloaded for a triage session — never committed
/logs_*/
/job-logs*.txt

# Superpowers planning scratch (briefs, reports, ledger) — never committed
/.superpowers/

# Compiler-generated docs (`zig build-lib -femit-docs` writes here).
# Anchored to the root: `src/docs/` is the doc-index module and is tracked.
/docs/

# CI-produced data artifacts (published by CI, never hand-edited)
/generated/

# Native build byproducts (e.g. `zig build-lib` leaves a .lib next to the source)
*.lib
*.a
*.o
*.obj
