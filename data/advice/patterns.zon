.{
    .version = 1,
    .source_research_date = "2026-11-09",
    .patterns = .{
        .{
            .id = "P01",
            .name = "Table- and configuration-driven behaviour",
            .what_data_controls = "Behaviour within an engine's supported operations",
            .mechanism = "a stable engine interprets descriptions, parameters, or action tables.",
            .facts = .{
                .{ .text = "Linux Devicetree describes hardware for the operating system, decoupling machine-specific information from board/driver code.", .source = "S01", .evidence = .fact },
            },
            .candidate_uses = .{ "hardware variants", "protocol policies", "explicit state transitions" },
            .boundaries = .{"configuration can select supported operations; new operation semantics can require new code"},
            .checks = .{ "schema compatibility", "invalid entries", "conflicting rules", "defaults", "safe publication", "rollback" },
            .evidence = .synthesis,
            .sources = .{"S01"},
        },
        .{
            .id = "P02",
            .name = "Pattern–action programming",
            .what_data_controls = "Selection of actions for matching input",
            .facts = .{
                .{ .text = "AWK combines patterns with actions; actions may contain imperative control statements.", .source = "S05", .evidence = .fact },
            },
            .candidate_uses = .{ "record/stream inspection", "instrumentation", "message selection" },
            .boundaries = .{"matching input does not necessarily imply a state machine, relational fixed point, or asynchronous execution model"},
            .checks = .{ "multiple matches", "execution order", "conflicting actions", "explicit default behaviour" },
            .evidence = .synthesis,
            .sources = .{"S05"},
        },
        .{
            .id = "P03",
            .name = "Data-oriented design",
            .what_data_controls = "Physical representation and transformations",
            .facts = .{
                .{ .text = "Fabian emphasises data, transformations, workload characteristics, and the executing machine.", .source = "S15", .evidence = .fact },
                .{ .text = "DPDK guidance includes memory pools, per-core data, alignment, and NUMA-local allocation.", .source = "S06", .evidence = .fact },
            },
            .candidate_uses = .{ "memory-intensive loops", "bulk processing", "repeated access to subsets of records" },
            .boundaries = .{"data-oriented layout is distinct from configuration-driven behaviour and does not require machine learning"},
            .checks = .{ "actual field access", "ownership", "lifetime", "shared writes", "allocation", "conversion costs", "target hardware" },
            .evidence = .synthesis,
            .sources = .{ "S15", "S06" },
        },
        .{
            .id = "P04",
            .name = "Entity–component–system architecture",
            .what_data_controls = "Composition and query-based processing",
            .facts = .{
                .{ .text = "Flecs groups matching component sets into archetypes and supports queries that match and cache groups.", .source = "S16", .evidence = .fact },
            },
            .candidate_uses = .{"many objects processed by component combinations"},
            .boundaries = .{"ECS does not inherently guarantee locality improvements, parallel safety, Datalog semantics, or distributed consistency"},
            .checks = .{ "query frequency", "component combinations", "structural mutation rate", "reorganisation cost" },
            .evidence = .synthesis,
            .sources = .{"S16"},
        },
        .{
            .id = "P05",
            .name = "Declarative and relational programming",
            .what_data_controls = "Derived relationships and results",
            .facts = .{
                .{ .text = "Soufflé represents analysis input as facts and analysis specifications as rules, generating parallel C++ through intermediate representations.", .source = "S07", .evidence = .fact },
                .{ .text = "P2 compiles Network Datalog and uses a dataflow engine for network behaviour and state.", .source = "S08", .evidence = .fact },
            },
            .candidate_uses = .{ "recursive graph relationships", "static analysis", "relational policy" },
            .boundaries = .{"concise rules shift work to the engine; fewer handwritten lines do not establish lower total cost or correctness"},
            .checks = .{ "input abstraction correctness", "rule semantics", "memory use", "evaluation cost" },
            .evidence = .synthesis,
            .sources = .{ "S07", "S08" },
        },
        .{
            .id = "P06",
            .name = "Dataflow and incremental computation",
            .what_data_controls = "Dependencies, progress, and propagation of changes",
            .facts = .{
                .{ .text = "predetermined token production/consumption rates enable static scheduling for suitable signal-processing graphs.", .source = "S09", .evidence = .fact },
                .{ .text = "Naiad supports cyclic data-parallel computation with logical timestamps and progress coordination.", .source = "S03", .evidence = .fact },
                .{ .text = "differential computation extends incremental maintenance to nested iteration.", .source = "S10", .evidence = .fact },
            },
            .candidate_uses = .{ "SDF for sufficiently regular pipelines", "timely/differential computation for iterative or changing state" },
            .boundaries = .{"static scheduling is not a deadline proof; incremental maintenance does not guarantee cheap updates; logical timestamps are not necessarily wall-clock deadlines"},
            .checks = .{ "rates", "topology", "execution time", "buffering", "retained state", "update propagation cost" },
            .evidence = .synthesis,
            .sources = .{ "S09", "S03", "S10" },
        },
        .{
            .id = "P07",
            .name = "Schema-driven generation and staged compilation",
            .what_data_controls = "Generated implementation and binding time",
            .facts = .{
                .{ .text = "TableGen factors domain descriptions into records processed by code-generation backends.", .source = "S02", .evidence = .fact },
                .{ .text = "Halide separates algorithm specification from scheduling choices such as tiling, storage, vectorisation, and parallelism.", .source = "S11", .evidence = .fact },
            },
            .candidate_uses = .{ "repetitive compiler descriptions", "computations with multiple implementation schedules" },
            .boundaries = .{"declarative descriptions need not be interpreted on the hot path. Decide explicitly which choices bind at build time, startup, or runtime."},
            .checks = .{ "specification", "generator/compiler", "generated artifacts", "tool versions", "reproducibility" },
            .evidence = .synthesis,
            .sources = .{ "S02", "S11" },
        },
        .{
            .id = "P08",
            .name = "Programmable infrastructure",
            .what_data_controls = "Constrained extension of processing behaviour",
            .facts = .{
                .{ .text = "P4 separates describing packet-processing functionality from populating forwarding rules.", .source = "S17", .evidence = .fact },
                .{ .text = "The eBPF verifier tracks register/stack states and checks access conditions.", .source = "S18", .evidence = .fact },
            },
            .candidate_uses = .{"constrained infrastructure extension through a supported target interface"},
            .boundaries = .{"eBPF programs are executable code, not ordinary configuration; verifier acceptance is not proof of application correctness or timing. P4 and eBPF are different execution mechanisms."},
            .checks = .{ "input validity", "admission rules", "application policy correctness", "resource/performance bounds" },
            .evidence = .synthesis,
            .sources = .{ "S17", "S18" },
        },
        .{
            .id = "P09",
            .name = "Event- and descriptor-driven execution",
            .what_data_controls = "Work submission and completion handling",
            .facts = .{
                .{ .text = "io_uring represents operations through shared submission queues and reports results through completion queues; shared queue state requires correct memory ordering.", .source = "S12", .evidence = .fact },
            },
            .candidate_uses = .{"many outstanding I/O operations"},
            .boundaries = .{"asynchronous descriptors do not automatically provide a declarative dependency graph, zero-copy payload handling, or a latency improvement. Concurrency and queue depth require workload-specific evaluation."},
            .checks = .{ "buffer ownership/lifetime", "request-completion matching", "cancellation", "shutdown", "ordering", "queue limits", "backpressure" },
            .evidence = .synthesis,
            .sources = .{"S12"},
        },
        .{
            .id = "P10",
            .name = "Profile-guided optimisation (PGO)",
            .what_data_controls = "Compilation choices informed by execution profiles",
            .facts = .{
                .{ .text = "Clang uses sampled or instrumented execution profiles to inform compilation and warns about unrepresentative profiles.", .source = "S04", .evidence = .fact },
            },
            .candidate_uses = .{"software with measurable deployment workloads"},
            .boundaries = .{"PGO does not require ML. A favourable training workload does not establish deployment benefit."},
            .checks = .{ "representative profiling", "independent evaluation traces", "workload shifts", "build reproducibility" },
            .evidence = .synthesis,
            .sources = .{"S04"},
        },
        .{
            .id = "P11",
            .name = "Learned indexes",
            .what_data_controls = "Search guidance informed by data distributions",
            .facts = .{
                .{ .text = "learned indexing uses models to guide search while additional mechanisms preserve index semantics.", .source = "S13", .evidence = .fact },
                .{ .text = "PGM search returns an estimated position and a bounded candidate range.", .source = "S19", .evidence = .fact },
                .{ .text = "Marcus et al. demonstrate favourable comparisons for read-only, in-memory dense-array workloads; the study investigates caching, key size, and construction costs.", .source = "S20", .evidence = .result },
            },
            .candidate_uses = .{"distributions and access patterns where prediction plus exact search is economical"},
            .boundaries = .{"approximate internal prediction need not imply approximate lookup results. The cited benchmark does not establish superiority for all update-heavy or disk-bound workloads."},
            .checks = .{ "exactness", "bound validity", "tuned conventional baseline", "construction", "updates", "memory", "changed distributions" },
            .evidence = .synthesis,
            .sources = .{ "S13", "S19", "S20" },
        },
        .{
            .id = "P12",
            .name = "Learned runtime policies",
            .what_data_controls = "Allocation or scheduling decisions",
            .facts = .{
                .{ .text = "Decima uses reinforcement learning for workload-specific scheduling.", .source = "S14", .evidence = .fact },
                .{ .text = "its 25-node Spark evaluation reported at least 21% improvement in average job completion time against evaluated hand-tuned heuristics and up to twofold improvement under high load.", .source = "S14", .evidence = .result },
            },
            .candidate_uses = .{"complex resource decisions with measurable objectives and enforceable constraints"},
            .boundaries = .{"the Decima result is not a universal scheduler speedup, fairness result, or hard real-time guarantee."},
            .checks = .{ "objective", "fairness requirements", "distribution shift", "inference/retraining costs", "constraint violations", "fallback frequency" },
            .evidence = .synthesis,
            .sources = .{"S14"},
        },
    },
}
